# Copy to .env.production and fill every REPLACE_WITH_RANDOM_HEX value.
# Never commit the filled file.
# Passwords must be non-empty and match [A-Za-z0-9_.-] so they are URL-safe in
# DATABASE_URL and safe to interpolate into the Postgres init SQL and realm JSON.
# Generate one per password with: openssl rand -hex 24

PUBLIC_BASE_URL=https://ofcf.hostedservices.cloud

POSTGRES_USER=postgres
POSTGRES_DB=ccaas
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
APP_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
WIDGET_TOKEN=REPLACE_WITH_RANDOM_HEX

# The Postgres init script creates a separate keycloak role and database.
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX
AGENT_PASSWORD=REPLACE_WITH_RANDOM_HEX
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX

KEYCLOAK_AUDIENCE=ccaas-spa
TRUST_PROXY=true
RATE_LIMIT_ENABLED=true

# Set by docker-compose.prod.yml from the values above; listed here for reference only.
# DATABASE_URL=postgres://app_user:$APP_DB_PASSWORD@postgres:5432/$POSTGRES_DB
# KEYCLOAK_ISSUER=$PUBLIC_BASE_URL/auth/realms/ccaas
# KEYCLOAK_JWKS_URL=http://keycloak:8080/auth/realms/ccaas/protocol/openid-connect/certs
# KEYCLOAK_TOKEN_URL=$PUBLIC_BASE_URL/auth/realms/ccaas/protocol/openid-connect/token
